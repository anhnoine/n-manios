craft parse_json text
    hold i = 0
    hold len_s = len(text)
    craft skip_ws
        spin while i < len_s
            check text[i] == " " or text[i] == "\t" or text[i] == "\n" or text[i] == "\r"
                set i = i + 1
            or
                give i
            end
        end
    end
    craft read_str
        check text[i] != '"'
            give ""
        end
        set i = i + 1
        hold start = i
        spin while i < len_s and text[i] != '"'
            check text[i] == "\\"
                set i = i + 1
            end
            set i = i + 1
        end
        give substr(text, start, i - start - 1)
    end
    craft read_num
        set i = i + 1
        hold neg = false
        check text[i] == "-"
            set neg = true
            set i = i + 1
        end
        hold start = i
        spin while i < len_s and (isdigit(text[i]) or text[i] == ".")
            set i = i + 1
        end
        hold s = substr(text, start, i - start)
        check contains(s, ".")
            give float(s)
        or
            check neg
                give -int(s)
            or
                give int(s)
            end
        end
    end
    craft read_val
        set i = skip_ws()
        check i >= len_s
            give val_none()
        end
        check text[i] == '"'
            set i = i + 1
            hold s = read_str()
            set json = s
            give s
        or
            check text[i] == "{" or text[i] == "["
            or
                give read_num()
            end
        end
        give val_none()
    end
    give val_none()
end