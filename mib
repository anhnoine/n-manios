#!/bin/bash
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

if [ -n "$PREFIX" ] && [ -d "$PREFIX" ] && [ "$PREFIX" != "/usr" ]; then
    LIB_DIR="$HOME/.manios/lib"
    BIN_DIR="$PREFIX/bin"
else
    LIB_DIR="$HOME/.manios/lib"
    BIN_DIR="/usr/local/bin"
fi

print_banner() {
    echo -e "${CYAN}+----------------------------------+${NC}"
    echo -e "${CYAN}|  ${BOLD}mib${NC}${CYAN} - Manios Package Manager  |${NC}"
    echo -e "${CYAN}+----------------------------------+${NC}"
}

ensure_lib_dir() {
    if [ ! -d "$LIB_DIR" ]; then
        mkdir -p "$LIB_DIR"
        echo -e "${GREEN}  Tao: $LIB_DIR${NC}"
    fi
}

count_files() {
    local count=0
    if [ -d "$1" ]; then
        count=$(find "$1" -name "*.mno" -type f 2>/dev/null | wc -l)
    fi
    echo "$count"
}

cmd_help() {
    print_banner
    echo ""
    echo -e "${BOLD}Cach dung:${NC} mib <lenh> [tham so]"
    echo ""
    echo -e "${BOLD}Lenh:${NC}"
    echo -e "  ${GREEN}install <src>${NC}         Cai dat lib (file .mno hoac folder)"
    echo -e "  ${GREEN}uninstall|remove <ten>${NC}  Xoa lib da cai dat"
    echo -e "  ${GREEN}list|ls${NC}               Liet ke lib da cai"
    echo -e "  ${GREEN}create <ten>${NC}           Tao lib moi"
    echo -e "  ${GREEN}init${NC}                  Tao ~/.manios/lib/"
    echo -e "  ${GREEN}path${NC}                  Hien thi duong dan lib"
    echo -e "  ${GREEN}tree [ten]${NC}            Hien thi cay thu muc lib"
    echo -e "  ${GREEN}help${NC}                  Tro giup"
    echo ""
    echo -e "${BOLD}Vi du:${NC}"
    echo "  mib install ./mylib.mno            # cai file lib"
    echo "  mib install ./requests/             # cai nguyen folder lib"
    echo "  mib install ./lib/utils.mno         # cai lib tu folder khac"
    echo "  mib install https://ex.com/a.mno    # cai tu URL"
    echo "  mib remove requests                 # xoa lib requests"
    echo "  mib remove requests/                # xoa folder lib"
    echo "  mib tree                            # xem tat ca lib"
    echo "  mib tree requests                   # xem lib requests"
    echo ""
}

cmd_init() {
    ensure_lib_dir
    echo -e "${GREEN}  San sang: $LIB_DIR${NC}"
}

cmd_path() {
    echo "$LIB_DIR"
}

cmd_list() {
    ensure_lib_dir
    echo -e "${BOLD}Thu vien da cai dat:${NC}"
    echo "----------------------------------"
    if [ ! -d "$LIB_DIR" ]; then
        echo "  (rong)"
        return
    fi
    local total=0
    for item in "$LIB_DIR"/*; do
        [ -e "$item" ] || continue
        local name=$(basename "$item")
        if [ -f "$item" ] && [[ "$name" == *.mno ]]; then
            local size=$(wc -c < "$item" 2>/dev/null || echo "?")
            echo -e "  ${GREEN}${name}${NC}  (${size}B)"
            total=$((total + 1))
        elif [ -d "$item" ]; then
            local fc=$(count_files "$item")
            echo -e "  ${CYAN}${name}/${NC}  (${fc} files)"
            total=$((total + 1))
        fi
    done
    echo "----------------------------------"
    echo -e "  Tong: ${BOLD}${total}${NC} lib"
}

cmd_tree() {
    local target="$1"
    if [ -z "$target" ]; then
        echo -e "${BOLD}$LIB_DIR${NC}"
        if [ -d "$LIB_DIR" ]; then
            (cd "$LIB_DIR" && find . -name "*.mno" -type f | sort | while read -r f; do
                echo "  $f"
            done)
        fi
    else
        local tpath="$LIB_DIR/$target"
        if [ -d "$tpath" ]; then
            echo -e "${BOLD}${target}/${NC}"
            (cd "$tpath" && find . -name "*.mno" -type f | sort | while read -r f; do
                echo "  ${target}/$f"
            done)
        elif [ -f "$tpath" ]; then
            echo -e "  ${GREEN}${target}${NC}"
        else
            echo -e "  ${RED}Khong tim thay: $target${NC}"
        fi
    fi
}

install_file() {
    local src="$1"
    local dest_name="$2"
    ensure_lib_dir
    local dest="$LIB_DIR/$dest_name"
    mkdir -p "$(dirname "$dest")"
    cp "$src" "$dest"
    echo -e "${GREEN}  Da cai: $dest_name${NC}"
}

install_folder() {
    local src_dir="$1"
    local lib_name="$2"
    ensure_lib_dir
    local dest="$LIB_DIR/$lib_name"
    rm -rf "$dest"
    cp -r "$src_dir" "$dest"
    find "$dest" -name "*.pyc" -delete 2>/dev/null || true
    find "$dest" -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
    find "$dest" -name ".git" -type d -exec rm -rf {} + 2>/dev/null || true
    local fc=$(count_files "$dest")
    echo -e "${GREEN}  Da cai: ${lib_name}/  (${fc} files)${NC}"
}

cmd_install() {
    local src="$1"
    if [ -z "$src" ]; then
        echo -e "${RED}  Loi: chua chi dinh source${NC}"
        echo "  mib install <file.mno | folder | URL>"
        exit 1
    fi

    if [[ "$src" == http://* ]] || [[ "$src" == https://* ]]; then
        ensure_lib_dir
        local fname=$(basename "$src")
        local tmp="/tmp/mib_dl_${fname}"
        echo -e "${YELLOW}  Dang tai: $src${NC}"
        if command -v curl >/dev/null 2>&1; then
            curl -sL "$src" -o "$tmp"
        elif command -v wget >/dev/null 2>&1; then
            wget -q "$src" -O "$tmp"
        else
            echo -e "${RED}  Can curl hoac wget${NC}"
            exit 1
        fi
        if [ ! -f "$tmp" ]; then
            echo -e "${RED}  Tai that bai${NC}"
            exit 1
        fi
        if [[ "$fname" == *.zip ]]; then
            local zipdir="/tmp/mib_zip_${fname}"
            rm -rf "$zipdir"
            mkdir -p "$zipdir"
            unzip -o "$tmp" -d "$zipdir" >/dev/null 2>&1
            local top=$(find "$zipdir" -mindepth 1 -maxdepth 1 -type d | head -1)
            if [ -n "$top" ] && [ -d "$top" ]; then
                local dname=$(basename "$top")
                if [ "$dname" != "$(basename "$fname" .zip)" ]; then
                    top="$zipdir"
                fi
                install_folder "$top" "$(basename "$top")"
            else
                local mno_count=$(find "$zipdir" -name "*.mno" -type f | wc -l)
                if [ "$mno_count" -gt 0 ]; then
                    install_folder "$zipdir" "$(basename "$fname" .zip)"
                else
                    echo -e "${RED}  Zip khong chua .mno file nao${NC}"
                fi
            fi
            rm -rf "$zipdir"
        else
            local dest_name="$fname"
            [[ "$dest_name" != *.mno ]] && dest_name="${dest_name}.mno"
            install_file "$tmp" "$dest_name"
        fi
        rm -f "$tmp"
        return
    fi

    if [ -d "$src" ]; then
        local dname=$(basename "$src")
        install_folder "$src" "$dname"
        return
    fi

    if [ -f "$src" ]; then
        local fname=$(basename "$src")
        local dest_name="$fname"
        [[ "$dest_name" != *.mno ]] && dest_name="${dest_name}.mno"
        install_file "$src" "$dest_name"
        return
    fi

    echo -e "${RED}  Khong tim thay: $src${NC}"
    exit 1
}

cmd_remove() {
    local lib="$1"
    if [ -z "$lib" ]; then
        echo -e "${RED}  Loi: chua chi dinh ten lib${NC}"
        echo "  mib remove <ten>"
        exit 1
    fi
    local target="$LIB_DIR/$lib"
    if [ -d "$target" ]; then
        rm -rf "$target"
        echo -e "${GREEN}  Da xoa: ${lib}/${NC}"
    elif [ -f "$target" ]; then
        rm -f "$target"
        echo -e "${GREEN}  Da xoa: $lib${NC}"
    elif [ -f "$LIB_DIR/${lib}.mno" ]; then
        rm -f "$LIB_DIR/${lib}.mno"
        echo -e "${GREEN}  Da xoa: ${lib}.mno${NC}"
    else
        echo -e "${RED}  Khong tim thay: $lib${NC}"
        exit 1
    fi
}

cmd_create() {
    local name="$1"
    if [ -z "$name" ]; then
        echo -e "${RED}  Loi: chua chi dinh ten${NC}"
        echo "  mib create <ten>"
        exit 1
    fi
    mkdir -p "$name"
    if [ ! -f "$name/init.mno" ]; then
        printf '' > "$name/init.mno"
    fi
    echo -e "${GREEN}  Da tao: ${name}/  (chua init.mno)${NC}"
    echo -e "  Chinh sua va chay: ${YELLOW}mib install ./${name}${NC}"
}

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
    install|i|add)
        cmd_install "$@"
        ;;
    remove|rm|uninstall|delete|del)
        cmd_remove "$@"
        ;;
    list|ls)
        cmd_list
        ;;
    tree|t)
        cmd_tree "$@"
        ;;
    create|new)
        cmd_create "$@"
        ;;
    init)
        cmd_init
        ;;
    path|dir)
        cmd_path
        ;;
    help|--help|-h|"")
        cmd_help
        ;;
    *)
        if [ -d "$COMMAND" ] || [ -f "$COMMAND" ]; then
            cmd_install "$COMMAND" "$@"
        else
            echo -e "${RED}  Lenh khong hop le: $COMMAND${NC}"
            echo "  Go ${YELLOW}mib help${NC}"
            exit 1
        fi
        ;;
esac
